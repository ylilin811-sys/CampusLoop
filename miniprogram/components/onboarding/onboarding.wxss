/* components/onboarding/onboarding.wxss */
.onboarding-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: #FFFFFF;
  z-index: 9999;
  display: flex;
  flex-direction: column;
}

@media (prefers-color-scheme: dark) {
  .onboarding-mask {
    background: #121212;
  }
}

.skip-btn {
  position: absolute;
  top: 100rpx;
  right: 40rpx;
  z-index: 10000;
  background: rgba(0, 0, 0, 0.08);
  color: #666666;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.guide-swiper {
  flex: 1;
  width: 100%;
}

.swiper-content {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

.illustration-box {
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-bottom: 60rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.08);
}

.bg-orange {
  background: linear-gradient(135deg, #FFE8D6 0%, #FFD0B0 100%);
}

.bg-blue {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
}

.bg-green {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.emoji-hero {
  font-size: 80rpx;
  letter-spacing: 12rpx;
}

.coin-badge {
  position: absolute;
  bottom: 20rpx;
  right: 20rpx;
  width: 100rpx;
  height: 100rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 50rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.12);
}

.text-box {
  text-align: center;
  margin-top: 20rpx;
}

.text-box .title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-main, #333333);
  margin-bottom: 24rpx;
  display: block;
}

.text-box .desc {
  font-size: 28rpx;
  color: var(--text-secondary, #666666);
  line-height: 1.6;
  white-space: pre-line;
}

.footer-area {
  height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.dots-box {
  display: flex;
  gap: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 8rpx;
  background: #E0E0E0;
  transition: all 0.3s ease;
}

.dot.active {
  width: 48rpx;
  background: var(--primary-color, #FF8A3D);
}

.start-btn {
  width: 80% !important;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 32rpx;
  padding: 0;
}
