/** app.wxss - 全局样式、动画定义与主题配置 **/

page {
  --primary-color: #FF8A3D;
  --primary-light: #FFF0E6;
  --primary-dark: #E06C20;
  --text-main: #333333;
  --text-secondary: #666666;
  --text-muted: #999999;
  --bg-color: #F7F8FA;
  --card-bg: #FFFFFF;
  --border-color: #EEEEEE;
  --shadow-color: rgba(0, 0, 0, 0.06);
  --success-color: #07C160;
  --danger-color: #FA5151;
  --tag-secondhand: #4A90E2;
  --tag-group: #FF8A3D;

  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Segoe UI, Arial, Roboto, 'PingFang SC', 'Hierarchy SC', 'Microsoft Yahei', sans-serif;
  box-sizing: border-box;
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  page {
    --primary-color: #FF8A3D;
    --primary-light: #3D2618;
    --text-main: #E5E5E5;
    --text-secondary: #A0A0A0;
    --text-muted: #666666;
    --bg-color: #121212;
    --card-bg: #1E1E1E;
    --border-color: #2C2C2C;
    --shadow-color: rgba(0, 0, 0, 0.3);
  }
}

/* 通用容器与卡片 */
.container {
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--card-bg);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx var(--shadow-color);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.card:active {
  transform: scale(0.98);
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-secondhand {
  background: #EBF3FF;
  color: var(--tag-secondhand);
}

.tag-group {
  background: var(--primary-light);
  color: var(--tag-group);
}

/* 按钮基础样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF9A52 0%, #FF8A3D 100%);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-weight: 600;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 61, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.97);
}

/* 动画1: 淡入上移（交错延迟） */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fade-in-up {
  animation: fadeInUp 0.5s ease forwards;
}

/* 动画2: 爱心弹跳 + 缩放 */
@keyframes heartBounce {
  0% { transform: scale(1); }
  25% { transform: scale(1.35) rotate(-10deg); }
  50% { transform: scale(0.9) rotate(5deg); }
  75% { transform: scale(1.15) rotate(0); }
  100% { transform: scale(1); }
}

.animate-heart-bounce {
  animation: heartBounce 0.45s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}

/* 动画3: 呼吸脉冲 */
@keyframes pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(255, 138, 61, 0.6);
  }
  70% {
    box-shadow: 0 0 0 20rpx rgba(255, 138, 61, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(255, 138, 61, 0);
  }
}

.animate-pulse {
  animation: pulse 2s infinite;
}

/* 动画4: 骨架屏闪烁 */
@keyframes skeletonShimmer {
  0% { opacity: 0.6; }
  50% { opacity: 1.0; }
  100% { opacity: 0.6; }
}

.skeleton-item {
  background: var(--border-color);
  border-radius: 12rpx;
  animation: skeletonShimmer 1.4s ease-in-out infinite;
}
