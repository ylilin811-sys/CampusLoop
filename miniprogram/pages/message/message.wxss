/* pages/message/message.wxss */
.message-container {
  padding-bottom: 40rpx;
}

/* 广播 Notification */
.notice-card {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #FFF9F5 0%, #FFF0E6 100%);
  border: 1rpx solid #FFD0B0;
  margin-bottom: 24rpx;
}

@media (prefers-color-scheme: dark) {
  .notice-card {
    background: #2C1E14;
    border-color: #5E3922;
  }
}

.notice-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.notice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 4rpx;
  display: block;
}

.notice-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

/* 对话列表 */
.chat-item {
  display: flex;
  align-items: center;
  padding: 24rpx !important;
}

.avatar-box {
  position: relative;
  width: 90rpx;
  height: 90rpx;
  margin-right: 24rpx;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.unread-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: var(--danger-color);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  width: 32rpx;
  height: 32rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chat-info {
  flex: 1;
  overflow: hidden;
}

.chat-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.user-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.time-str {
  font-size: 22rpx;
  color: var(--text-muted);
}

.goods-ref {
  font-size: 22rpx;
  color: var(--primary-color);
  margin-bottom: 6rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.last-msg {
  font-size: 26rpx;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 对话 Modal */
.chat-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: var(--bg-color);
  z-index: 9999;
  display: flex;
  flex-direction: column;
}

.modal-header {
  height: 100rpx;
  background: var(--card-bg);
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.close-btn {
  font-size: 36rpx;
  color: var(--text-muted);
  padding: 10rpx;
}

.chat-body {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

.msg-bubble {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.msg-bubble.self {
  flex-direction: row-reverse;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin: 0 16rpx;
}

.msg-text {
  max-width: 65%;
  background: var(--card-bg);
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: var(--text-main);
  box-shadow: 0 2rpx 8rpx var(--shadow-color);
  line-height: 1.5;
}

.msg-bubble.self .msg-text {
  background: var(--primary-color);
  color: #FFFFFF;
}

.chat-footer {
  height: 110rpx;
  background: var(--card-bg);
  border-top: 1rpx solid var(--border-color);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 20rpx;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg-color);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.send-btn {
  width: 140rpx !important;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}
