/* pages/home/home.wxss */
.home-container {
  padding-bottom: 120rpx;
}

/* 1. 搜索栏 */
.search-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--bg-color);
  padding: 16rpx 24rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  border-radius: 44rpx;
  padding: 14rpx 28rpx;
  box-shadow: 0 4rpx 12rpx var(--shadow-color);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-main);
}

.clear-icon {
  font-size: 26rpx;
  color: var(--text-muted);
  padding: 8rpx;
}

/* 2. 分类标签栏 */
.category-scroll {
  white-space: nowrap;
  padding: 10rpx 24rpx;
  display: flex;
  margin-bottom: 10rpx;
}

.category-item {
  display: inline-flex;
  align-items: center;
  background: var(--card-bg);
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx var(--shadow-color);
  transition: all 0.2s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #FF9A52 0%, #FF8A3D 100%);
  color: #FFFFFF;
}

.category-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.category-name {
  font-size: 26rpx;
  font-weight: 500;
}

/* 3. 瀑布流/双列商品网格 */
.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-card {
  width: 48%;
  padding: 0 !important;
  overflow: hidden;
  box-sizing: border-box;
}

.img-wrapper {
  position: relative;
  width: 100%;
  height: 280rpx;
  background: #F0F0F0;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.tag-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
}

.goods-info {
  padding: 18rpx;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  line-height: 1.4;
  height: 78rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

/* 拼单进度条 */
.group-progress-box {
  margin-bottom: 12rpx;
}

.progress-bar-bg {
  width: 100%;
  height: 12rpx;
  background: #FFE8D6;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9A52 0%, #FF8A3D 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.progress-text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  margin-top: 6rpx;
}

.count-num {
  color: var(--text-secondary);
}

.status-badge.ongoing {
  color: var(--primary-color);
}

.status-badge.full {
  color: var(--success-color);
  font-weight: 600;
}

/* 底部价格与收藏 */
.goods-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.price-box {
  color: var(--primary-color);
  font-weight: 700;
}

.currency {
  font-size: 24rpx;
}

.price-val {
  font-size: 36rpx;
}

.unit {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: normal;
}

.fav-btn {
  padding: 8rpx;
}

.fav-icon {
  font-size: 32rpx;
}

/* 卖家简要信息 */
.seller-meta {
  display: flex;
  align-items: center;
  padding-top: 10rpx;
  border-top: 1rpx solid var(--border-color);
}

.avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.nickname {
  font-size: 22rpx;
  color: var(--text-muted);
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.location {
  font-size: 20rpx;
  color: var(--text-muted);
  background: #F2F2F2;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

/* 空状态与加载提示 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-emoji {
  font-size: 90rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

.load-more {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 悬浮发布按钮 FAB */
.fab-wrapper {
  position: fixed;
  right: 36rpx;
  bottom: 140rpx;
  z-index: 990;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.fab-main-btn {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: linear-gradient(135deg, #FF9A52 0%, #FF8A3D 100%);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(255, 138, 61, 0.4);
}

.fab-icon {
  font-size: 52rpx;
  font-weight: 300;
  line-height: 1;
}

.fab-menu {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.fab-sub-btn {
  display: flex;
  align-items: center;
  background: var(--card-bg);
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.sub-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.sub-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}
