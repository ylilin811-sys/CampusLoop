/* pages/publish/publish.wxss */
.publish-container {
  padding-bottom: 80rpx;
}

/* 1. 类型切换 */
.type-switch {
  display: flex;
  padding: 12rpx !important;
  background: var(--card-bg);
  border-radius: 24rpx;
}

.switch-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border-radius: 18rpx;
  transition: all 0.3s ease;
}

.switch-item.active {
  background: var(--primary-light);
  color: var(--primary-color);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 61, 0.15);
}

.switch-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.switch-title {
  font-size: 30rpx;
}

/* 2. 表单与图片上传 */
.form-card {
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 24rpx;
}

.uploader-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.uploader-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.uploader-img {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.uploader-add-btn {
  width: 200rpx;
  height: 200rpx;
  background: #F8F8F8;
  border: 2rpx dashed #DDDDDD;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

@media (prefers-color-scheme: dark) {
  .uploader-add-btn {
    background: #2A2A2A;
    border-color: #444444;
  }
}

.add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.add-text {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 表单字段 */
.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-item.vertical {
  flex-direction: column;
  align-items: flex-start;
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
  width: 220rpx;
}

.input-field {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-main);
}

.picker-value {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text-main);
}

.arrow {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-left: 12rpx;
}

.textarea-field {
  width: 100%;
  height: 200rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

@media (prefers-color-scheme: dark) {
  .textarea-field {
    background: #2A2A2A;
  }
}

.word-count {
  align-self: flex-end;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
}

.submit-btn {
  width: 100% !important;
  height: 92rpx;
  line-height: 92rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
  padding: 0;
}
