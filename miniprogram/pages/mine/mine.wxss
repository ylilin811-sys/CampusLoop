/* pages/mine/mine.wxss */
.mine-container {
  padding-bottom: 80rpx;
}

/* 1. Profile 头部卡片 */
.profile-card {
  padding: 36rpx 24rpx 20rpx 24rpx !important;
}

.user-row {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid var(--primary-light);
  margin-right: 24rpx;
}

.user-name-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main);
}

.verify-tag {
  background: #E8F5E9;
  color: #07C160;
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 10rpx;
}

.user-campus {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 未登录授权区域 */
.login-wrapper {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
  gap: 24rpx;
}

.avatar-choose-btn {
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 60rpx;
  padding: 0 !important;
  margin: 0 !important;
  background: none !important;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: 60rpx;
}

.login-inputs {
  flex: 1;
}

.nickname-input {
  font-size: 26rpx;
  border-bottom: 1rpx solid var(--border-color);
  padding: 10rpx 0;
  margin-bottom: 12rpx;
}

.login-btn {
  width: 100% !important;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  margin: 0;
  padding: 0;
}

/* 统计条 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* 2. Tabs 切换 */
.tabs-card {
  padding: 0 !important;
  overflow: hidden;
}

.tab-header {
  display: flex;
  border-bottom: 1rpx solid var(--border-color);
}

.tab-title {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: var(--text-secondary);
  position: relative;
}

.tab-title.active {
  color: var(--primary-color);
  font-weight: 700;
}

.tab-title.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--primary-color);
  border-radius: 3rpx;
}

.tab-content {
  padding: 24rpx;
}

.empty-box {
  text-align: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  display: block;
  margin-bottom: 12rpx;
}

.empty-text {
  font-size: 26rpx;
  color: var(--text-muted);
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.item-thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.item-details {
  flex: 1;
}

.item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 8rpx;
  display: block;
}

.item-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--primary-color);
}

.arrow {
  font-size: 24rpx;
  color: var(--text-muted);
}

/* 3. 菜单项 */
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 28rpx;
  color: var(--text-main);
  font-weight: 500;
}
